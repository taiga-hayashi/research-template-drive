# Gitへの登録だけを制御する。Google Drive同期の除外にはならない。
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.secrets/
.env
.env.*
!.env.example
.dvc/config.local
.DS_Store
data/**
!data/**/
!data/**/.gitkeep
!data/**/README.md
archive/**
!archive/**/
!archive/**/.gitkeep
!archive/**/README.md
!archive/**/*.dvc
cache/**
!cache/.gitkeep
tmp/**
!tmp/.gitkeep
